// ==UserScript==
// @name         OpenGuessr Stats & Inspector (IDM Edition)
// @namespace    ogstats.idm
// @version      1.3.0
// @description  IDM-style floating inspector for OpenGuessr / WorldGuessr hubs: live Street View & Google stats, cookie manager (copy/edit/delete + explanations), user stats, saved token (bearer) login profiles with one-click login, network/storage capture, raw mode & console. Works on Violentmonkey and Tampermonkey.
// @author       Dwarf THE PEBBLE Johnson
// @match        *://*/*
// @run-at       document-start
// @noframes
// @grant        GM_cookie
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        GM_setClipboard
// @grant        GM_registerMenuCommand
// @grant        unsafeWindow
// ==/UserScript==

/* ============================================================================
 * HOW TO TARGET YOUR HUB (read me)
 * ----------------------------------------------------------------------------
 * By default this script matches every page but only ACTIVATES on hosts that
 * look like an OpenGuessr hub (see CFG.hosts below). Two ways to target it:
 *
 *   1) Edit CFG.hosts below and add your hub hostname, e.g. 'myhub.example.com'
 *   2) Or replace the @match line at the top with your own, e.g.
 *        // @match  https://myhub.example.com/*
 *        // @match  http://localhost:3000/*
 *
 * There is also a Violentmonkey/Tampermonkey menu command "OG Stats: enable on
 * this host" which whitelists the current host (saved with GM storage).
 *
 * Interface: floating panel like an IDM window.
 *   - Ctrl+Shift+O .......... toggle the panel
 *   - Header buttons ........ Basic/Advanced mode, wide/narrow, minimize, close
 *   - Drag the header ....... move the panel
 *   - Tokens tab ............ save bearer/secret tokens with a label,
 *                             then log back in with one click
 *   - Advanced mode adds .... Network log, Storage, Raw JSON, Console, Help
 * ==========================================================================*/

(function () {
  'use strict';

  /* ================================ CONFIG ================================ */

  const CFG = {
    // Script activates when location.hostname contains any of these:
    hosts: ['openguessr', 'worldguessr', 'geoguess', 'localhost', '127.0.0.1'],
    allSites: false, // set true to activate everywhere

    // REST endpoints probed for user stats (first hit wins; ?secret= appended
    // automatically when a token is found in storage). Edit for your hub.
    userEndpoints: [
      '/api/user/getUser',
      '/api/user',
      '/api/users/@me',
      '/api/me',
      '/api/profile',
      '/api/eloRank'
    ],

    netLogLimit: 400,     // network events kept
    bodyLimit: 65536,     // max response bytes captured per request
    wsFrameLimit: 2000,   // max characters kept per websocket frame
    refreshMs: 1000       // live panorama poll rate
  };

  /* ============================== ENV HELPERS ============================= */

  const W = (typeof unsafeWindow !== 'undefined') ? unsafeWindow : window;

  function store(key, val) {
    try {
      if (typeof GM_setValue === 'function') {
        if (arguments.length > 1) { GM_setValue(key, val); return val; }
        return typeof GM_getValue === 'function' ? GM_getValue(key) : undefined;
      }
    } catch (e) { /* fall through */ }
    const k = 'ogstats.' + key;
    if (arguments.length > 1) { try { localStorage.setItem(k, JSON.stringify(val)); return val; } catch (e) { return val; } }
    try { const raw = localStorage.getItem(k); return raw == null ? undefined : JSON.parse(raw); } catch (e) { return undefined; }
  }

  function copyText(text) {
    try {
      if (typeof GM_setClipboard === 'function') { GM_setClipboard(String(text), 'text'); return true; }
    } catch (e) { /* fall through */ }
    try {
      const ta = document.createElement('textarea');
      ta.value = String(text);
      ta.style.cssText = 'position:fixed;opacity:0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      return true;
    } catch (e) { return false; }
  }

  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function trunc(s, n) {
    s = String(s == null ? '' : s);
    return s.length > n ? s.slice(0, n) + '…' : s;
  }

  // base64url -> text (used by the JWT decoder; page context has atob)
  function b64UrlDecode(s) {
    s = String(s).replace(/-/g, '+').replace(/_/g, '/').replace(/\s+/g, '');
    while (s.length % 4) s += '=';
    const bin = atob(s);
    try { return decodeURIComponent(escape(bin)); } catch (e) { return bin; }
  }

  // returns {header, payload, sig} for a JWT, or null if not a JWT
  function decodeJwt(v) {
    try {
      const parts = String(v || '').trim().split('.');
      if (parts.length < 2 || !parts[0] || !parts[1]) return null;
      const header = JSON.parse(b64UrlDecode(parts[0]));
      const payload = JSON.parse(b64UrlDecode(parts[1]));
      if (!header || typeof header !== 'object' || !payload || typeof payload !== 'object') return null;
      return { header: header, payload: payload, sig: parts.length > 2 ? parts[2] : null };
    } catch (e) { return null; }
  }

  function now() {
    const d = new Date();
    return d.toTimeString().slice(0, 8) + '.' + String(d.getMilliseconds()).padStart(3, '0');
  }

  function isTargetSite() {
    if (CFG.allSites) return true;
    const saved = store('host.' + location.hostname);
    if (saved === true) return true;
    return CFG.hosts.some(h => location.hostname.indexOf(h) !== -1);
  }

  /* ================================= STATE ================================ */

  const state = {
    active: false,
    tab: 'overview',
    mode: store('mode') || 'basic',      // 'basic' | 'advanced'
    size: store('size') || 'normal',     // 'normal' | 'wide'
    minimized: false,
    visible: store('openOnLoad') !== false,
    pos: store('pos') || { x: 16, y: 16 },
    cookies: [],
    cookiesSource: 'document.cookie',
    netLog: [],
    netPaused: false,
    locations: [],      // captured coordinates
    panos: [],          // captured panorama ids
    userSnaps: [],      // user-like objects sniffed from traffic
    maps: [],
    livePanos: [],
    livePanoData: null,
    userFetches: [],     // [{endpoint, status, data}]
    tokens: [],
    googleCookies: [],
    consoleOut: [],
    consoleInput: '',
    jwtInput: '',
    jwtOut: '',
    modal: null,         // cookie edit/add modal payload
    detectedAuth: [],    // tokens detected on this page (refreshed on Tokens tab render)
    savedTokens: store('savedTokens') || []   // saved login profiles [{id, label, items, savedAt}]
  };

  /* ============================ NET CAPTURE HOOKS ========================= */

  function addNet(entry) {
    if (state.netPaused) return;
    entry.t = now();
    state.netLog.push(entry);
    if (state.netLog.length > CFG.netLogLimit) state.netLog.shift();
    if (panel && state.tab === 'network' && state.mode === 'advanced') softRefreshNet();
  }

  // -- response body sniffing ------------------------------------------------
  function sniffBody(url, text) {
    if (!text) return;
    // 1) JSON scan
    if (text[0] === '{' || text[0] === '[') {
      try {
        const j = JSON.parse(text);
        recordFacts(j, url);
      } catch (e) { /* not valid json */ }
    }
    // 2) regex scan for pano ids & coordinates (Google endpoints)
    let m;
    const rePano = /[?&](?:panoid|pano)=([A-Za-z0-9_-]{8,})/g;
    while ((m = rePano.exec(text)) !== null) recordPano(m[1], url);
    const reLL1 = /!3d(-?\d{1,3}.\d+)!4d(-?\d{1,3}.\d+)/g;
    while ((m = reLL1.exec(text)) !== null) recordLocation(parseFloat(m[1]), parseFloat(m[2]), url);
    const reLL2 = /@(-?\d{1,3}.\d+),(-?\d{1,3}.\d+)/g;
    while ((m = reLL2.exec(text)) !== null) recordLocation(parseFloat(m[1]), parseFloat(m[2]), url);
  }

  function isGoogleUrl(u) {
    return /googleapis.com|gstatic.com|google.com|streetview/i.test(u || '');
  }

  // -- fetch ------------------------------------------------------------------
  function patchFetch() {
    if (typeof W.fetch !== 'function') return;
    const orig = W.fetch;
    W.fetch = function (input, init) {
      const url = (typeof input === 'string') ? input : (input && input.url) || '';
      const method = ((init && init.method) || (input && input.method) || 'GET').toUpperCase();
      return orig.apply(this, arguments).then(res => {
        addNet({ kind: 'fetch', method, status: res.status, url, google: isGoogleUrl(url) });
        try {
          if (res && typeof res.clone === 'function') {
            res.clone().text().then(t => {
              if (t && t.length <= CFG.bodyLimit) sniffBody(url, t);
            }).catch(() => {});
          }
        } catch (e) { /* ignore */ }
        return res;
      }, err => {
        addNet({ kind: 'fetch', method, error: String(err), url, google: isGoogleUrl(url) });
        throw err;
      });
    };
  }

  // -- XMLHttpRequest --------------------------------------------------------
  function patchXHR() {
    if (typeof W.XMLHttpRequest !== 'function') return;
    const OrigOpen = W.XMLHttpRequest.prototype.open;
    const OrigSend = W.XMLHttpRequest.prototype.send;
    W.XMLHttpRequest.prototype.open = function (method, url) {
      this.__ogstats = { method: String(method || 'GET').toUpperCase(), url: String(url || '') };
      return OrigOpen.apply(this, arguments);
    };
    W.XMLHttpRequest.prototype.send = function (body) {
      const info = this.__ogstats || {};
      addNet({ kind: 'xhr', method: info.method, url: info.url, google: isGoogleUrl(info.url) });
      this.addEventListener('load', () => {
        const st = this.status;
        addNet({ kind: 'xhr:done', method: info.method, status: st, url: info.url, google: isGoogleUrl(info.url) });
        try {
          const t = this.responseText;
          if (t && t.length <= CFG.bodyLimit) sniffBody(info.url, t);
        } catch (e) { /* cross-origin etc. */ }
      });
      return OrigSend.apply(this, arguments);
    };
  }

  // -- WebSocket (socket.io multiplayer traffic lives here) -------------------
  function patchWebSocket() {
    if (typeof W.WebSocket !== 'function') return;
    const OWS = W.WebSocket;
    function PatchedWS(url, protos) {
      const ws = protos === undefined ? new OWS(url) : new OWS(url, protos);
      try {
        ws.addEventListener('message', ev => captureFrame('ws-in', String(url), ev.data));
        const os = ws.send.bind(ws);
        ws.send = function (d) { captureFrame('ws-out', String(url), d); return os(d); };
      } catch (e) { /* ignore */ }
      return ws;
    }
    PatchedWS.prototype = OWS.prototype;
    PatchedWS.OPEN = OWS.OPEN; PatchedWS.CONNECTING = OWS.CONNECTING;
    PatchedWS.CLOSING = OWS.CLOSING; PatchedWS.CLOSED = OWS.CLOSED;
    W.WebSocket = PatchedWS;
  }

  function captureFrame(dir, url, data) {
    const text = typeof data === 'string' ? data : '[binary]';
    const cut = text.slice(0, CFG.wsFrameLimit);
    addNet({ kind: 'ws', dir, url, data: cut, google: isGoogleUrl(url) });
    sniffBody(url, cut);
  }

  /* ============================== FACT RECORDING =========================== */

  function recordLocation(lat, lng, src) {
    const key = lat.toFixed(5) + ',' + lng.toFixed(5);
    if (state.locations.some(l => l.key === key)) return;
    state.locations.unshift({ key, lat, lng, src, t: now() });
    if (state.locations.length > 60) state.locations.pop();
  }

  function recordPano(id, src) {
    if (state.panos.some(p => p.id === id)) return;
    state.panos.unshift({ id, src, t: now() });
    if (state.panos.length > 60) state.panos.pop();
  }

  function looksLikeUser(o) {
    if (!o || typeof o !== 'object') return false;
    return ('username' in o) || ('name' in o && 'elo' in o) || ('points' in o && 'xp' in o);
  }

  // recursively scan JSON payloads for locations / pano ids / user objects
  function recordFacts(node, url, depth) {
    depth = depth || 0;
    if (depth > 6 || node == null || typeof node !== 'object') return;
    if (Array.isArray(node)) { for (let i = 0; i < Math.min(node.length, 60); i++) recordFacts(node[i], url, depth + 1); return; }
    try {
      const lat = Number(node.lat != null ? node.lat : (node.latitude != null ? node.latitude : NaN));
      const lng = Number(node.lng != null ? node.lng : (node.longitude != null ? node.longitude : NaN));
      if (isFinite(lat) && isFinite(lng)) recordLocation(lat, lng, url);
      const pid = node.panoId || node.pano || node.panoid;
      if (typeof pid === 'string' && pid.length >= 8) recordPano(pid, url);
      if (looksLikeUser(node)) {
        const sig = JSON.stringify(node).slice(0, 400);
        if (!state.userSnaps.some(u => u.sig === sig)) {
          state.userSnaps.unshift({ sig, data: node, src: url, t: now() });
          if (state.userSnaps.length > 20) state.userSnaps.pop();
        }
      }
      Object.keys(node).forEach(k => recordFacts(node[k], url, depth + 1));
    } catch (e) { /* circular etc. */ }
  }

  /* =========================== GOOGLE MAPS TRACKER ========================= */

  let mapsPatched = false;
  let mapsPollTries = 0;

  function patchGoogleMaps() {
    const g = W.google && W.google.maps;
    if (!g || mapsPatched) return !!mapsPatched;
    mapsPatched = true;
    try {
      const OM = g.Map;
      if (typeof OM === 'function') {
        function PatchedMap() { const m = new OM(...arguments); state.maps.push(m); return m; }
        PatchedMap.prototype = OM.prototype;
        g.Map = PatchedMap;
      }
    } catch (e) { /* ignore */ }
    try {
      const OP = g.StreetViewPanorama;
      if (typeof OP === 'function') {
        function PatchedSVP() { const p = new OP(...arguments); state.livePanos.push(p); return p; }
        PatchedSVP.prototype = OP.prototype;
        g.StreetViewPanorama = PatchedSVP;
      }
    } catch (e) { /* ignore */ }
    return true;
  }

  function readPano(p) {
    if (!p) return null;
    const out = {};
    try { out.pano = p.getPano ? p.getPano() : null; } catch (e) { out.pano = null; }
    try {
      const pos = p.getPosition ? p.getPosition() : null;
      if (pos && typeof pos.lat === 'function') { out.lat = pos.lat(); out.lng = pos.lng(); }
      else if (pos && typeof pos.lat === 'number') { out.lat = pos.lat; out.lng = pos.lng; }
    } catch (e) { /* ignore */ }
    try { const pov = p.getPov ? p.getPov() : null; if (pov) out.pov = pov; } catch (e) { /* ignore */ }
    try { const ppov = p.getPhotographerPov ? p.getPhotographerPov() : null; if (ppov) out.photographerPov = ppov; } catch (e) { /* ignore */ }
    try { if (p.getZoom) out.zoom = p.getZoom(); } catch (e) { /* ignore */ }
    try { const c = p.getCopyright ? p.getCopyright() : null; if (c) out.copyright = c; } catch (e) { /* ignore */ }
    try {
      const links = p.getLinks ? p.getLinks() : null;
      if (links && links.length) out.links = links.slice(0, 8).map(l => ({ pano: l.panoId, heading: l.heading, description: l.description }));
    } catch (e) { /* ignore */ }
    return out;
  }

  function pollPanos() {
    try {
      patchGoogleMaps();
      // panos reachable via map.getStreetView()
      state.maps.forEach(m => {
        try {
          const sv = m.getStreetView && m.getStreetView();
          if (sv && state.livePanos.indexOf(sv) === -1) state.livePanos.push(sv);
        } catch (e) { /* ignore */ }
      });
      state.livePanos = state.livePanos.filter(p => { try { return !!(p.getPosition || p.getPano); } catch (e) { return false; } });
      let best = null;
      state.livePanos.forEach(p => {
        const d = readPano(p);
        if (d && (d.pano || isFinite(d.lat))) {
          if (!best || (d.pano && !best.pano)) best = d;
        }
      });
      state.livePanoData = best;
      if (best && isFinite(best.lat)) recordLocation(best.lat, best.lng, 'streetview:live');
      if (best && best.pano) recordPano(best.pano, 'streetview:live');
    } catch (e) { /* ignore */ }
  }

  /* ============================== COOKIE MODULE ============================ */

  const COOKIE_INFO = {
    'SID': 'Google: main account session identifier. Sent to google.com and its services to keep you signed in. Deleting it signs you out of Google.',
    'HSID': 'Google: secure "host-specific" auth cookie, paired with SID. Required for staying signed in; HttpOnly.',
    'SSID': 'Google: secure session cookie, paired with HSID. Used for verifying account sessions; HttpOnly.',
    'APISID': 'Google: API session cookie used by Google APIs (Maps, Street View embeds, etc.). Readable by JavaScript.',
    'SAPISID': 'Google: signed API session cookie used for authorization on many Google endpoints. Often combined with SAPISIDHASH headers.',
    'SEID': 'Google: search engine session ID used for extra session security.',
    '__Secure-1PSID': 'Google: prefixed, Secure-only version of the SID cookie (modern accounts). HttpOnly.',
    '__Secure-3PSID': 'Google: anti-session-hijacking SID variant bound to a third-party context. HttpOnly.',
    '__Secure-1PSIDTS': 'Google: SID timestamp/rotation cookie — proves the PSID is fresh and not stolen.',
    '__Secure-3PSIDTS': 'Google: third-party SID timestamp/rotation cookie.',
    '__Secure-1PAPISID': 'Google: prefixed SAPISID variant (same purpose, Secure-only transport).',
    '__Secure-3PAPISID': 'Google: third-party prefixed SAPISID variant.',
    '__Secure-ENID': 'Google: encrypted ID used in ads/consent flows; expires ~2 years.',
    'NID': 'Google: "number of days" preferences cookie — remembers device preferences and helps serve search/ads.',
    'CONSENT': 'Google: stores your GDPR/cookie-consent choices (e.g. YES+ / rollup).',
    'SOCS': 'Google: stores consent state for cookies themselves ("SOCS" = State of Consent Storage).',
    '1P_JAR': 'Google: first-party ad cookie jar date — used for ad measurement.',
    'ANID': 'Google: ad cookie used with 3P cookies in some regions.',
    'OTZ': 'Google: aggregates visitor behavior across pages for analytics.',
    'AEC': 'Google: anti-abuse cookie (invisible captcha / reCAPTCHA-related).',
    'UULE': 'Google: location hint parameter sometimes mirrored into a cookie for localized results.',
    'connect.sid': 'Express/Express-Session (self-hosted Node hubs): your signed server session. Deleting it logs you out of the hub.',
    'io': 'Socket.IO handshake cookie: links your WebSocket connection to your HTTP session — how multiplayer rooms recognise you.',
    'csrftoken': 'Cross-Site Request Forgery token — must accompany state-changing POST requests.',
    'session': 'Generic server session cookie — identifies your login on this hub.',
    'token': 'Auth token stored as a cookie (some hubs keep this in localStorage instead — check the Storage tab).',
    'secret': 'WorldGuessr/OpenGuessr-style user secret (UUID). Full account access for the API — treat like a password.',
    'PHPSESSID': 'PHP session identifier.',
    'JSESSIONID': 'Java (e.g. Tomcat) session identifier.',
    '_ga': 'Google Analytics: identifies a unique visitor (client ID), 2-year lifetime.',
    '_gid': 'Google Analytics: distinguishes users for 24 hours.',
    '_gat': 'Google Analytics: throttles request rate (1 minute).'
  };

  function cookieExplain(name) {
    if (COOKIE_INFO[name]) return COOKIE_INFO[name];
    if (/^__Secure-/i.test(name)) return 'A cookie with the __Secure- prefix: only sent over HTTPS and scoped tightly by the site (see RFC 6265bis prefixes).';
    if (/^__/.test(name)) return 'Double-underscore prefix — an "idle/legacy" cookie that is ignored by browsers but often kept for auditing.';
    if (/sess|sid/i.test(name)) return 'Looks like a session cookie — identifies your session to the server.';
    if (/csrf|xsrf/i.test(name)) return 'CSRF/XSRF protection token.';
    if (/_ga|_gid|_gat|_gcl/i.test(name)) return 'Google Analytics / ads measurement cookie.';
    if (/jwt/i.test(name)) return 'Appears to contain a JWT (JSON Web Token) — signed login credential.';
    return 'No known explanation for this cookie name. It is set by this site (or an embedded service).';
  }

  function gmCookie(op, detail) {
    return new Promise((resolve, reject) => {
      if (typeof GM_cookie === 'undefined') return reject(new Error('GM_cookie not available'));
      try {
        GM_cookie[op](detail, function (cookies, error) {
          if (error) return reject(error);
          resolve(cookies);
        });
      } catch (e) { reject(e); }
    });
  }

  async function refreshCookies() {
    let list = [];
    let source = 'document.cookie';
    try {
      const gm = await gmCookie('list', {});
      if (gm && gm.length) {
        list = gm.map(c => ({
          name: c.name, value: c.value, domain: c.domain, path: c.path,
          secure: !!c.secure, httpOnly: !!c.httpOnly, session: !!c.session,
          expirationDate: c.expirationDate || null, source: 'GM_cookie'
        }));
        source = 'GM_cookie (full access — includes HttpOnly)';
      }
    } catch (e) {
      const doc = parseDocCookies();
      if (doc.length || !document.cookie) {
        list = doc;
      } else {
        list = doc;
      }
    }
    if (!list.length) list = parseDocCookies();
    state.cookies = list;
    state.cookiesSource = source;
    state.googleCookies = list.filter(c => /(^|.)google(.com)?$|googleapis|gstatic|.google./i.test(c.domain || '') || /^(__Secure|SID|HSID|SSID|APISID|SAPISID|SEID|NID|CONSENT|SOCS|1P_JAR|AEC|OTZ|ANID|UULE)/i.test(c.name));
    return list;
  }

  function parseDocCookies() {
    return String(document.cookie || '').split(';').map(s => s.trim()).filter(Boolean).map(pair => {
      const i = pair.indexOf('=');
      const name = i > -1 ? pair.slice(0, i) : pair;
      const value = i > -1 ? pair.slice(i + 1) : '';
      return { name: name, value: value, domain: location.hostname, path: '/', source: 'document.cookie' };
    });
  }

  function cookieRaw(c) { return c.name + '=' + c.value; }

  async function saveCookie(c) {
    // Prefer GM_cookie (can also write HttpOnly cookies when the manager allows)
    try {
      await gmCookie('set', {
        name: c.name, value: c.value,
        domain: c.domain || undefined, path: c.path || '/',
        secure: c.secure === undefined ? true : !!c.secure,
        httpOnly: !!c.httpOnly,
        expirationDate: c.expires ? c.expires : undefined
      });
      return { ok: true, via: 'GM_cookie' };
    } catch (e) { /* fall back to document.cookie */ }
    let s = c.name + '=' + c.value;
    s += '; path=' + (c.path || '/');
    if (c.domain && c.domain !== location.hostname) s += '; domain=' + c.domain;
    if (c.expires) {
      const d = (typeof c.expires === 'number') ? new Date(c.expires < 1e12 ? c.expires * 1000 : c.expires) : new Date(c.expires);
      s += '; expires=' + d.toUTCString();
    }
    if (c.secure) s += '; secure';
    document.cookie = s;
    return { ok: true, via: 'document.cookie' };
  }

  async function deleteCookie(c) {
    try {
      await gmCookie('delete', { name: c.name, domain: c.domain || undefined, path: c.path || '/' });
    } catch (e) { /* fall back */ }
    let s = c.name + '=; path=' + (c.path || '/');
    if (c.domain) s += '; domain=' + (c.domain || location.hostname);
    s += '; expires=Thu, 01 Jan 1970 00:00:00 GMT';
    document.cookie = s;
    await refreshCookies();
  }

  /* ============================== USER MODULE ============================== */

  function looksLikeToken(k, v) {
    if (/token|secret|auth|jwt|bearer|session/i.test(k)) return true;
    return /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/.test(String(v || ''));
  }

  function scanTokens() {
    const out = [];
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        const v = localStorage.getItem(k);
        if (looksLikeToken(k, v)) out.push({ where: 'localStorage', key: k, value: v });
      }
      for (let i = 0; i < sessionStorage.length; i++) {
        const k = sessionStorage.key(i);
        const v = sessionStorage.getItem(k);
        if (looksLikeToken(k, v)) out.push({ where: 'sessionStorage', key: k, value: v });
      }
    } catch (e) { /* ignore */ }
    state.tokens = out;
    return out;
  }

  async function fetchUserStats() {
    scanTokens();
    const token = (state.tokens.find(t => /secret|token/i.test(t.key)) || {}).value;
    state.userFetches = [];
    for (const ep of CFG.userEndpoints) {
      let url = ep;
      if (token && url.indexOf('?') === -1) url += '?secret=' + encodeURIComponent(token);
      try {
        const headers = token ? { 'Authorization': 'Bearer ' + token } : {};
        const r = await fetch(url, { credentials: 'include', headers: headers });
        let data = null;
        try { data = await r.json(); } catch (e) { data = null; }
        state.userFetches.push({ endpoint: ep, status: r.status, data });
        if (r.ok && data && typeof data === 'object') recordFacts(data, url);
      } catch (e) {
        state.userFetches.push({ endpoint: ep, status: 0, error: String(e) });
      }
    }
  }

  /* ============================ TOKEN LOGIN MODULE ========================= */

  function uid() {
    return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
  }

  // Collect everything on this page that can log you back in:
  // storage secrets/tokens, JWT bearers and session-ish cookies.
  function detectAuthItems() {
    const items = [];
    const seen = new Set();
    const push = (where, key, value) => {
      if (key == null || value == null) return;
      const id = where + '|' + key;
      if (seen.has(id)) return;
      seen.add(id);
      items.push({ where: where, key: key, value: String(value) });
    };
    scanTokens().forEach(t => push(t.where, t.key, t.value));
    findBearer().forEach(j => push(j.store, j.key, j.value));
    (state.cookies || []).forEach(c => {
      if (/sess|sid|token|secret|auth|jwt/i.test(c.name)) push('cookie', c.name, c.value);
    });
    return items;
  }

  function saveTokenProfile(label, items) {
    if (!items || !items.length) return;
    state.savedTokens.unshift({
      id: uid(),
      label: (label || '').trim() || 'Untitled token',
      items: items,
      savedAt: new Date().toISOString()
    });
    store('savedTokens', state.savedTokens);
  }

  // One-click login: write the saved items back into storage/cookies, remove
  // competing token keys from storage, then reload the page.
  async function loginWithProfile(p) {
    if (!p || !p.items || !p.items.length) return;
    const keep = new Set(p.items.map(it => it.where + '|' + it.key));
    // clean out token-like storage keys that are not part of this profile
    // (makes account switching reliable; cookies are left untouched)
    (state.detectedAuth && state.detectedAuth.length ? state.detectedAuth : detectAuthItems()).forEach(it => {
      if (it.where === 'cookie' || keep.has(it.where + '|' + it.key)) return;
      try {
        if (it.where === 'localStorage') localStorage.removeItem(it.key);
        else if (it.where === 'sessionStorage') sessionStorage.removeItem(it.key);
      } catch (e) { /* ignore */ }
    });
    for (const it of p.items) {
      try {
        if (it.where === 'cookie') {
          await saveCookie({ name: it.key, value: it.value, path: '/', secure: location.protocol === 'https:' });
        } else if (it.where === 'sessionStorage') {
          sessionStorage.setItem(it.key, it.value);
        } else {
          localStorage.setItem(it.key, it.value);
        }
      } catch (e) { /* ignore */ }
    }
    location.reload();
  }

