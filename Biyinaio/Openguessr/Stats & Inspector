      '<pre class="raw">' + esc(trunc(JSON.stringify(s.data, null, 2), 1500)) + '</pre>' +
      '<span class="btn" data-action="copy" data-copy="' + esc(JSON.stringify(s.data)) + '">Copy</span></div>').join('');
    return `
      <div class="card">
        <h3>Auth tokens & secrets found in storage</h3>
        ${tok || '<div class="empty">No token-like keys found in local/session storage.</div>'}
        <div class="note" style="margin-top:6px">WorldGuessr/OpenGuessr-style hubs keep a UUID "secret" that is a full account credential — never share it. Save it with a label in the <b>Tokens</b> tab for one-click login.</div>
      </div>
      ${renderBearerCard()}
      <div class="card">
        <h3>API probes</h3>
        <div class="note">Endpoints tried: ${CFG.userEndpoints.map(esc).join(', ')}</div>
        <div style="margin-top:8px"><span class="btn go" data-action="user-fetch">Probe user endpoints now</span></div>
      </div>
      ${probes}
      ${snaps}`;
  }

  function renderTokens() {
    state.detectedAuth = detectAuthItems();
    const det = state.detectedAuth.map((it, idx) => {
      const d = decodeJwt(it.value);
      let chip = '';
      if (d && d.payload && d.payload.exp) {
        const valid = d.payload.exp * 1000 > Date.now();
        chip = ' <span class="chip ' + (valid ? 'ok' : 'hot') + '">' + (valid ? 'valid JWT' : 'EXPIRED JWT') + '</span>';
      }
      return '<div class="row"><div class="k">' + esc(trunc(it.where + '.' + it.key, 32)) + '</div><div class="v">' +
        esc(trunc(it.value, 44)) + chip +
        ' <span class="btn go" data-action="tok-save-one" data-i="' + idx + '">Save + label</span></div></div>';
    }).join('');
    const saved = state.savedTokens.map((p, idx) => {
      const items = p.items.map(it =>
        '<div class="ck-exp">' + esc(it.where) + '.' + esc(it.key) + ' = ' + esc(trunc(it.value, 70)) + '</div>').join('');
      let expChip = '';
      const exps = p.items.map(it => {
        const d = decodeJwt(it.value);
        return (d && d.payload && d.payload.exp) ? d.payload.exp * 1000 : 0;
      }).filter(Boolean);
      if (exps.length) {
        const valid = Math.min.apply(null, exps) > Date.now();
        expChip = ' <span class="chip ' + (valid ? 'ok' : 'hot') + '">' + (valid ? 'valid' : 'EXPIRED') + '</span>';
      }
      return '<div class="cookie">' +
        '<div class="ck-name">' + esc(p.label) + expChip + '</div>' +
        '<div class="ck-exp">saved ' + esc(p.savedAt) + ' · ' + p.items.length + ' item(s)</div>' +
        items +
        '<div>' +
        '<span class="btn go" data-action="tok-login" data-i="' + idx + '">⚡ Log in with this token</span>' +
        '<span class="btn" data-action="tok-copy" data-i="' + idx + '">Copy JSON</span>' +
        '<span class="btn warn" data-action="tok-del" data-i="' + idx + '">Delete</span>' +
        '</div></div>';
    }).join('');
    return `
      <div class="card">
        <h3>Saved tokens — one-click login</h3>
        <div class="note">Pick a saved token and it is written back into storage/cookies, competing storage token keys are removed, and the page reloads — logging you in as that account. Cookies are never removed automatically.</div>
        <div style="margin-top:8px">
          <span class="btn go" data-action="tok-save-session">＋ Save current session as profile</span>
        </div>
      </div>
      ${saved || '<div class="empty">No saved tokens yet. Save one from the list below (single token) or save your whole current session as a profile.</div>'}
      <div class="card">
        <h3>Detected tokens on this page</h3>
        ${det || '<div class="empty">No tokens detected — sign in on the hub first, or press Refresh in Overview.</div>'}
        <div class="note" style="margin-top:6px">Detected automatically: storage secrets/bearer JWTs and session cookies. "Save + label" stores a single item; the profile button stores all of them together under one label.</div>
      </div>`;
  }

  function renderNetwork() {
    const rows = state.netLog.slice().reverse().map((n, i) => {
      const label = n.kind === 'ws' ? (n.dir === 'ws-out' ? 'WS→' : 'WS←') : (n.method || n.kind);
      const status = n.status != null ? ' <span class="chip ' + (n.status < 400 ? 'ok' : 'hot') + '">' + n.status + '</span>' : (n.error ? ' <span class="chip hot">ERR</span>' : '');
      const data = n.data ? esc(trunc(n.data, 800)) : '';
      return `<div class="netrow" data-action="net-toggle" data-i="${i}">
        <span class="nettime">${esc(n.t)}</span><span class="netmethod">${esc(label)}</span>${n.google ? '<span class="chip">G</span>' : ''}${status}
        <div class="neturl">${esc(trunc(n.url || '', 130))}</div>
        ${data ? '<div class="netdata">' + data + '</div>' : ''}
      </div>`;
    }).join('');
    return `
      <div class="card">
        <h3>Network capture (${state.netLog.length})</h3>
        <div class="note">fetch · XHR · WebSocket frames. Click a row to expand its payload. Google calls are tagged <span class="chip">G</span>.</div>
        <div style="margin-top:8px">
          <span class="btn" data-action="net-pause">${state.netPaused ? '▶ Resume capture' : '⏸ Pause capture'}</span>
          <span class="btn warn" data-action="net-clear">Clear log</span>
          <span class="btn" data-action="net-copy">Copy log JSON</span>
        </div>
      </div>
      ${rows || '<div class="empty">No traffic captured yet (this tab appears in Advanced mode).</div>'}`;
  }

  function renderStorage() {
    const looksLikeJwt = v =>
      typeof v === 'string' && v.indexOf('.') !== -1 &&
      /^[A-Za-z0-9_-]+.[A-Za-z0-9_-]+.[A-Za-z0-9_-]*$/.test(v);
    const dump = (name, storeName, storeObj) => {
      let n = 0;
      try { n = storeObj.length; } catch (e) { n = 0; }
      let rows = '';
      try {
        for (let i = 0; i < n; i++) {
          const k = storeObj.key(i), v = storeObj.getItem(k);
          let extra = '';
          if (looksLikeJwt(v)) {
            const d = decodeJwt(v);
            if (d) {
              const exp = d.payload && d.payload.exp
                ? '<br>expires: ' + esc(new Date(d.payload.exp * 1000).toLocaleString()) : '';
              extra = '<div class="ck-exp" style="color:#9fd6ff">' +
                'JWT header: ' + esc(JSON.stringify(d.header)) + '<br>' +
                'JWT payload: ' + esc(JSON.stringify(d.payload)) + exp + '</div>';
            }
          }
          rows += '<div class="row"><div class="k">' + esc(trunc(k, 40)) + '</div><div class="v">' + esc(trunc(v, 120)) +
            ' <span class="btn" data-action="copy" data-copy="' + esc(v) + '">copy</span>' +
            '<span class="btn go" data-action="st-edit" data-store="' + storeName + '" data-key="' + esc(k) + '">edit</span>' +
            '<span class="btn warn" data-action="st-del" data-store="' + storeName + '" data-key="' + esc(k) + '">del</span></div>' +
            extra + '</div>';
        }
      } catch (e) { rows = '<div class="empty">Storage unreadable.</div>'; }
      return '<div class="card"><h3>' + name + ' (' + n + ')</h3>' + (rows || '<div class="empty">Empty.</div>') + '</div>';
    };
    return '<div class="card"><h3>Storage editor</h3>' +
      '<div class="note">Values are editable in place; JWTs are decoded under their row. Caveat: signed tokens (like a <b>bearer</b> JWT) can be edited freely in storage, but the server only accepts ones whose signature matches — so you can swap in another <i>valid</i> token or delete this one, but changing the payload (userId, exp…) makes it invalid.</div></div>' +
      dump('localStorage', 'local', localStorage) + dump('sessionStorage', 'session', sessionStorage);
  }

  function renderRaw() {
    const json = JSON.stringify(snapshot(), null, 2);
    return `
      <div style="margin-bottom:8px">
        <span class="btn go" data-action="snapshot-copy">Copy snapshot JSON</span>
        <span class="btn" data-action="snapshot-download">Download .json</span>
        <span class="btn" data-action="refresh">Rebuild</span>
      </div>
      <pre class="raw">${esc(trunc(json, 60000))}</pre>`;
  }

  function renderConsole() {
    const out = state.consoleOut.slice(-40).map(l => esc(l)).join('\n');
    let jwtBlock = '';
    if (state.jwtOut) {
      jwtBlock = '<pre class="raw" style="margin-top:8px">' + esc(state.jwtOut) + '</pre>' +
        '<span class="btn" data-action="jwt-copy">Copy decoded</span> ' +
        '<span class="btn" data-action="jwt-clear">Clear result</span>';
    }
    return `
      <div class="card">
        <h3>JWT / bearer token decoder</h3>
        <div class="note" style="margin-bottom:6px">Paste any token and hit Decode (or press Enter). JWTs get their header, payload, signature and expiry broken out; anything else is tried as plain base64. Runs 100% locally — nothing leaves the page.</div>
        <input class="console-in" id="ogstats-jwt" placeholder="eyJhbGciOiJIUzI1NiIs... — paste any token here" value="${esc(state.jwtInput)}">
        <span class="btn go" data-action="jwt-decode">Decode</span>
        ${jwtBlock}
      </div>
      <div class="card">
        <h3>Console</h3>
        <div class="note" style="margin-bottom:6px">Runs JavaScript in the page context (like DevTools console). Use <code>google</code>, <code>fetch</code>, etc.</div>
        <input class="console-in" id="ogstats-console" placeholder="e.g. google.maps ? 'maps loaded' : 'no maps'" value="${esc(state.consoleInput)}">
        <span class="btn go" data-action="console-run">Run</span>
        <span class="btn" data-action="console-clear">Clear</span>
        <pre class="raw" style="margin-top:8px">${out || '<i>— console output appears here —</i>'}</pre>
      </div>`;
  }

  function renderHelp() {
    const attrs = [
      ['Name / Value', 'The only parts visible to JavaScript via document.cookie. Everything else is metadata.'],
      ['Domain', 'Which host(s) the cookie is sent to. A leading dot (.example.com) means all subdomains.'],
      ['Path', 'URL prefix the cookie is scoped to — / means every page.'],
      ['Expires / Max-Age', 'When the cookie dies. No expiry = session cookie (cleared when the browser closes).'],
      ['HttpOnly', 'JavaScript cannot read it (XSS protection). Only visible in this panel via GM_cookie.'],
      ['Secure', 'Only sent over HTTPS.'],
      ['SameSite', 'Lax/Strict limit cross-site sending; None (requires Secure) allows it — used for embeds & OAuth.'],
      ['__Secure- / __Host- prefixes', 'Name prefixes enforced by the browser: HTTPS-only, and (__Host-) no domain attribute with path=/.']
    ].map(([k, v]) => '<div class="row"><div class="k">' + esc(k) + '</div><div class="v">' + esc(v) + '</div></div>').join('');
    const known = Object.keys(COOKIE_INFO).sort().map(k =>
      '<div class="row"><div class="k">' + esc(k) + '</div><div class="v">' + esc(COOKIE_INFO[k]) + '</div></div>').join('');
    return `
      <div class="card"><h3>What am I looking at?</h3>
        <div class="note big">This is a debugger/inspector panel, in the spirit of an IDM floating window. It reads data that the page itself can access from your logged-in session: Street View state, cookies, storage and traffic. It runs entirely locally — nothing is uploaded.</div>
      </div>
      <div class="card"><h3>Token logins (Tokens tab)</h3>
        <div class="note">
          · Detected tokens (storage secrets, bearer JWTs, session cookies) can be saved with a custom label.<br>
          · "Save current session as profile" stores them all under one label — ideal for multiple accounts.<br>
          · "Log in with this token" writes the saved items back, removes competing storage tokens, and reloads the page.<br>
          · Saved tokens are stored in the userscript manager's GM storage (not in page storage), so they survive reloads.<br>
          · A JWT that shows EXPIRED will no longer work — re-login on the hub and save it again.
        </div>
      </div>
      <div class="card"><h3>Cookie attribute glossary</h3>${attrs}</div>
      <div class="card"><h3>Known cookie names</h3>${known}</div>
      <div class="card"><h3>Tips for your own hub</h3>
        <div class="note">
          · Edit <b>CFG.hosts</b> (top of the script) to your hub hostname.<br>
          · Edit <b>CFG.userEndpoints</b> to match your hub's user API routes.<br>
          · The Location tab fills from live Street View objects; the wire capture also catches coordinates in API/WebSocket traffic.<br>
          · HttpOnly cookie editing needs GM_cookie permissions in your userscript manager.<br>
          · Ctrl+Shift+O toggles the panel; the panel position is remembered.
        </div>
      </div>`;
  }

  // ---------- modal ----------

  function openCookieModal(c) {
    state.modal = {
      type: 'cookie',
      title: c ? 'Edit cookie' : 'Add cookie',
      name: c ? c.name : '',
      value: c ? c.value : '',
      domain: c && c.domain ? c.domain : location.hostname,
      path: c && c.path ? c.path : '/',
      expires: c && c.expirationDate ? new Date(c.expirationDate * 1000).toISOString().slice(0, 10) : '',
      secure: c ? (c.secure !== false) : (location.protocol === 'https:'),
      httpOnly: c ? !!c.httpOnly : false,
      isNew: !c
    };
    renderModal();
  }

  function openStorageModal(storeName, key) {
    const storeObj = storeName === 'session' ? sessionStorage : localStorage;
    state.modal = {
      type: 'storage',
      title: 'Edit storage value',
      store: storeName,
      key: key,
      value: storeObj.getItem(key) || ''
    };
    renderModal();
  }

  function openLabelModal(opts) {
    state.modal = {
      type: 'label',
      title: opts.title || 'Label this token',
      hint: opts.hint || '',
      value: opts.value || '',
      payload: opts.payload || []
    };
    renderModal();
  }

  function renderModal() {
    const m = state.modal;
    let el = shadow.querySelector('.modal-wrap');
    if (!m) { if (el) el.remove(); return; }
    if (!el) {
      el = document.createElement('div');
      el.className = 'modal-wrap';
      shadow.appendChild(el);
    }
    if (m.type === 'storage') {
      el.innerHTML = `<div class="modal">
        <h3>${esc(m.title)}</h3>
        <label>Key (${m.store === 'session' ? 'sessionStorage' : 'localStorage'})</label>
        <input value="${esc(m.key)}" readonly>
        <label>Value</label>
        <input id="m-value" value="${esc(m.value)}">
        <div class="foot">
          <span class="btn" data-action="modal-cancel">Cancel</span>
          <span class="btn go" data-action="modal-save-storage">Save value</span>
        </div>
      </div>`;
      return;
    }
    if (m.type === 'label') {
      el.innerHTML = `<div class="modal">
        <h3>${esc(m.title)}</h3>
        <div class="note" style="margin-bottom:8px">${esc(m.hint)}</div>
        <label>Label</label>
        <input id="m-label" value="${esc(m.value)}" placeholder="e.g. main account">
        <div class="foot">
          <span class="btn" data-action="modal-cancel">Cancel</span>
          <span class="btn go" data-action="modal-save-label">Save token</span>
        </div>
      </div>`;
      return;
    }
    el.innerHTML = `<div class="modal">
      <h3>${esc(m.title)}</h3>
      ${m.isNew ? '<label>Name</label><input id="m-name" value="">' : '<label>Name</label><input id="m-name" value="' + esc(m.name) + '" readonly>'}
      <label>Value</label><input id="m-value" value="${esc(m.value)}">
      <label>Domain</label><input id="m-domain" value="${esc(m.domain)}">
      <label>Path</label><input id="m-path" value="${esc(m.path)}">
      <label>Expires (YYYY-MM-DD, blank = session)</label><input id="m-expires" value="${esc(m.expires)}" placeholder="leave blank for session cookie">
      <label style="display:flex;gap:8px;align-items:center;margin-top:10px"><input type="checkbox" id="m-secure" style="width:auto" ${m.secure ? 'checked' : ''}> Secure (HTTPS only)</label>
      <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" id="m-httponly" style="width:auto" ${m.httpOnly ? 'checked' : ''}> HttpOnly (needs GM_cookie)</label>
      <div class="foot">
        <span class="btn" data-action="modal-cancel">Cancel</span>
        <span class="btn go" data-action="modal-save">Save cookie</span>
      </div>
    </div>`;
  }

  // ---------- main render ----------

  function render() {
    if (!panel) return;
    const tabs = tabList();
    if (!tabs.some(t => t[0] === state.tab)) state.tab = 'overview';
    const advanced = state.mode === 'advanced';
    panel.className = 'panel ' + (advanced ? 'advanced' : 'basic') + (state.size === 'wide' ? ' wide' : '');
    panel.style.left = Math.max(0, Math.min(state.pos.x, window.innerWidth - 80)) + 'px';
    panel.style.top = Math.max(0, Math.min(state.pos.y, window.innerHeight - 40)) + 'px';

    let body = '';
    switch (state.tab) {
      case 'overview': body = renderOverview(); break;
      case 'location': body = renderLocation(); break;
      case 'google': body = renderGoogle(); break;
      case 'cookies': body = renderCookies(); break;
      case 'user': body = renderUser(); break;
      case 'tokens': body = renderTokens(); break;
      case 'network': body = renderNetwork(); break;
      case 'storage': body = renderStorage(); break;
      case 'raw': body = renderRaw(); break;
      case 'console': body = renderConsole(); break;
      case 'help': body = renderHelp(); break;
      default: body = renderOverview();
    }

    panel.innerHTML = `
      <div class="hdr" data-drag="1">
        <span class="logo"></span>
        <span class="title">OG STATS — ${esc(location.hostname)}</span>
        <span class="mode ${advanced ? 'adv' : ''}" data-action="mode" title="Switch Basic / Advanced">${advanced ? 'ADVANCED' : 'BASIC'}</span>
        <span class="hbtn" data-action="size" title="Toggle width">${state.size === 'wide' ? '⇤' : '⇥'}</span>
        <span class="hbtn" data-action="min" title="Minimize">—</span>
        <span class="hbtn" data-action="close" title="Close (Ctrl+Shift+O)">✕</span>
      </div>
      <div class="tabs">${tabs.map(t => '<span class="tab ' + (state.tab === t[0] ? 'on' : '') + '" data-action="tab" data-tab="' + t[0] + '">' + t[1] + '</span>').join('')}</div>
      <div class="body">${body}</div>`;
    // don't rebuild the modal while the user is typing in it (live re-render)
    const typing = state.modal && shadow.activeElement && shadow.activeElement.closest &&
      shadow.activeElement.closest('.modal-wrap');
    if (!typing) renderModal();
  }

  function softRefreshNet() {
    // light-weight: only redraw when the network tab is visible
    if (netTimer) return;
    netTimer = setTimeout(() => {
      netTimer = null;
      if (panel && state.visible && !state.minimized && state.tab === 'network') render();
    }, 1500);
  }

  // ---------- actions ----------

  function onAction(action, el, ev) {
    const i = el.getAttribute('data-i');
    switch (action) {
      case 'tab': state.tab = el.getAttribute('data-tab'); render(); break;
      case 'mode':
        state.mode = state.mode === 'basic' ? 'advanced' : 'basic';
        store('mode', state.mode); render(); break;
      case 'size':
        state.size = state.size === 'wide' ? 'normal' : 'wide';
        store('size', state.size); render(); break;
      case 'min': state.minimized = true; renderPill(); break;
      case 'close': state.visible = false; hidePanel(); break;
      case 'refresh': (async () => { await refreshCookies(); render(); })(); break;
      case 'copy': copyText(el.getAttribute('data-copy')); flash(el, '✓ copied'); break;
      case 'snapshot-copy': copyText(JSON.stringify(snapshot(), null, 2)); flash(el, '✓ copied'); break;
      case 'snapshot-download': {
        const blob = new Blob([JSON.stringify(snapshot(), null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'ogstats-' + location.hostname + '-' + Date.now() + '.json';
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 5000);
        break;
      }
      case 'gmaps': {
        const lp = state.livePanoData;
        if (lp && isFinite(lp.lat)) window.open('https://www.google.com/maps/@' + lp.lat + ',' + lp.lng + ',3z', '_blank');
        else if (lp && lp.pano) window.open('https://www.google.com/maps/@?api=1&map_action=pano&pano=' + encodeURIComponent(lp.pano), '_blank');
        break;
      }
      case 'ck-copy-val': copyText(state.cookies[i].value); flash(el, '✓'); break;
      case 'ck-copy-raw': copyText(cookieRaw(state.cookies[i])); flash(el, '✓'); break;
      case 'ck-copy-json': copyText(JSON.stringify(state.cookies[i], null, 2)); flash(el, '✓'); break;
      case 'ck-copy-all': copyText(JSON.stringify(state.cookies, null, 2)); flash(el, '✓ all cookies copied'); break;
      case 'ck-export': {
        const blob = new Blob([JSON.stringify(state.cookies, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'cookies-' + location.hostname + '-' + Date.now() + '.json';
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 5000);
        break;
      }
      case 'ck-edit': openCookieModal(state.cookies[i]); break;
      case 'ck-add': openCookieModal(null); break;
      case 'ck-del': (async () => { await deleteCookie(state.cookies[i]); render(); })(); break;
      case 'st-edit': openStorageModal(el.getAttribute('data-store'), el.getAttribute('data-key')); break;
      case 'st-del': {
        const sn = el.getAttribute('data-store');
        (sn === 'session' ? sessionStorage : localStorage).removeItem(el.getAttribute('data-key'));
        scanTokens();
        render();
        break;
      }
      case 'tok-save-one': {
        const it = state.detectedAuth[i];
        if (!it) break;
        openLabelModal({
          title: 'Save token with label',
          hint: 'Give this token a name so you recognise it later (e.g. "alt account"). It appears in the saved list with a one-click login button.',
          value: it.key,
          payload: [it]
        });
        break;
      }
      case 'tok-save-session':
        openLabelModal({
          title: 'Save current session as profile',
          hint: 'All tokens detected below (storage secrets / bearer JWTs / session cookies) are saved together under one label. Use its "Log in" button to switch back to this account anytime.',
          value: 'account @ ' + location.hostname,
          payload: detectAuthItems()
        });
        break;
      case 'modal-save-label': {
        const m = state.modal;
        const input = shadow.getElementById('m-label');
        const label = input ? input.value : '';
        if (m && m.type === 'label') {
          saveTokenProfile(label, m.payload || []);
        }
        state.modal = null;
        render();
        break;
      }
      case 'tok-login': {
        const p = state.savedTokens[i];
        if (p) loginWithProfile(p);
        break;
      }
      case 'tok-copy': copyText(JSON.stringify(state.savedTokens[i], null, 2)); flash(el, '✓'); break;
      case 'tok-del':
        state.savedTokens.splice(i, 1);
        store('savedTokens', state.savedTokens);
        render();
        break;
      case 'modal-save-storage': {
        const m = state.modal;
        const input = shadow.getElementById('m-value');
        const storeObj = m.store === 'session' ? sessionStorage : localStorage;
        storeObj.setItem(m.key, input ? input.value : '');
        state.modal = null;
        scanTokens();
        render();
        break;
      }
      case 'modal-cancel': state.modal = null; renderModal(); break;
      case 'modal-save': (async () => {
        const g = id => { const e = shadow.getElementById(id); return e ? e.value : ''; };
        const m = state.modal;
        const expiresRaw = g('m-expires');
        const expires = expiresRaw ? new Date(expiresRaw + 'T23:59:59').getTime() / 1000 : undefined;
        await saveCookie({
          name: m.isNew ? g('m-name').trim() : m.name,
          value: g('m-value'),
          domain: g('m-domain').trim(),
          path: g('m-path').trim() || '/',
          expires: expires,
          secure: shadow.getElementById('m-secure').checked,
          httpOnly: shadow.getElementById('m-httponly').checked
        });
        state.modal = null;
        await refreshCookies();
        render();
      })(); break;
      case 'user-fetch': (async () => { await fetchUserStats(); render(); })(); break;
      case 'net-toggle': el.classList.toggle('open'); break;
      case 'net-pause': state.netPaused = !state.netPaused; render(); break;
      case 'net-clear': state.netLog = []; render(); break;
      case 'net-copy': copyText(JSON.stringify(state.netLog, null, 2)); flash(el, '✓'); break;
      case 'console-run': {
        const input = shadow.getElementById('ogstats-console');
        const code = input ? input.value : '';
        state.consoleInput = code;
        state.consoleOut.push('> ' + code);
        try {
          const result = W.eval ? W.eval(code) : (0, eval)(code);
          let out;
          try { out = JSON.stringify(result, null, 2); if (out === undefined) out = String(result); }
          catch (e) { out = String(result); }
          state.consoleOut.push(out != null ? out : 'undefined');
        } catch (e) {
          state.consoleOut.push('✖ ' + String(e));
        }
        render();
        break;
      }
      case 'jwt-decode': {
        const input = shadow.getElementById('ogstats-jwt');
        const raw = input ? input.value.trim() : '';
        state.jwtInput = raw;
        if (!raw) { state.jwtOut = 'Paste a token first.'; render(); break; }
        const d = decodeJwt(raw);
        if (d) {
          const iatTxt = d.payload.iat ? '\nissued:   ' + new Date(d.payload.iat * 1000).toISOString() : '';
          let expTxt = '';
          if (d.payload.exp) {
            const ms = d.payload.exp * 1000;
            expTxt = '\nexpires:  ' + new Date(ms).toISOString() + (ms < Date.now() ? '   (EXPIRED)' : '   (valid)');
          }
          state.jwtOut = 'JWT — header:\n' + JSON.stringify(d.header, null, 2) +
            '\n\nJWT — payload:\n' + JSON.stringify(d.payload, null, 2) +
            (d.sig ? '\n\nsignature (base64url — only your server can forge a new one):\n' + d.sig : '') +
            iatTxt + expTxt;
        } else {
          try {
            state.jwtOut = 'Not a JWT — decoded as base64:\n\n' + b64UrlDecode(raw);
          } catch (e) {
            state.jwtOut = '✖ Could not decode: not a valid JWT or base64.';
          }
        }
        render();
        break;
      }
      case 'jwt-copy': copyText(state.jwtOut); flash(el, '✓'); break;
      case 'jwt-clear': state.jwtOut = ''; state.jwtInput = ''; render(); break;
      case 'console-clear': state.consoleOut = []; render(); break;
    }
  }

  function flash(el, text) {
    const old = el.textContent;
    el.textContent = text;
    setTimeout(() => { if (el.isConnected) el.textContent = old; }, 900);
  }

  function setupEvents() {
    shadow.addEventListener('click', ev => {
      const el = ev.target.closest ? ev.target.closest('[data-action]') : null;
      if (!el) return;
      if (el.getAttribute('data-action') === 'net-toggle') { ev.stopPropagation(); onAction('net-toggle', el, ev); return; }
      onAction(el.getAttribute('data-action'), el, ev);
    });
    // panel drag
    shadow.addEventListener('pointerdown', ev => {
      const hdr = ev.target.closest ? ev.target.closest('[data-drag]') : null;
      if (!hdr) return;
      if (ev.target.closest('[data-action]')) return;
      const startX = ev.clientX, startY = ev.clientY;
      const ox = panel.offsetLeft, oy = panel.offsetTop;
      const move = e => {
        state.pos = { x: ox + e.clientX - startX, y: oy + e.clientY - startY };
        panel.style.left = Math.max(0, state.pos.x) + 'px';
        panel.style.top = Math.max(0, state.pos.y) + 'px';
      };
      const up = () => {
        document.removeEventListener('pointermove', move);
        document.removeEventListener('pointerup', up);
        store('pos', state.pos);
      };
      document.addEventListener('pointermove', move);
      document.addEventListener('pointerup', up);
    });
    // console / decoder Enter keys
    shadow.addEventListener('keydown', ev => {
      if (!ev.target || ev.key !== 'Enter') return;
      if (ev.target.id === 'ogstats-console') {
        ev.preventDefault();
        onAction('console-run', ev.target, ev);
      } else if (ev.target.id === 'ogstats-jwt') {
        ev.preventDefault();
        onAction('jwt-decode', ev.target, ev);
      }
    });
    // minimize pill
    shadow.addEventListener('click', ev => {
      if (ev.target && ev.target.id === 'ogstats-pill') {
        state.minimized = false; state.visible = true;
        ev.target.remove(); render(); showPanel();
      }
    });
  }

  function showPanel() { if (panel) { panel.style.display = 'flex'; render(); } }
  function hidePanel() { if (panel) panel.style.display = 'none'; }

  function renderPill() {
    if (panel) panel.style.display = 'none';
    let pill = shadow.getElementById('ogstats-pill');
    if (!pill) {
      pill = document.createElement('div');
      pill.className = 'pill';
      pill.id = 'ogstats-pill';
      pill.textContent = '📍 OG Stats';
      shadow.appendChild(pill);
    }
  }

  function ensurePanel() {
    if (host) return;
    host = document.createElement('div');
    host.id = 'ogstats-host';
    document.documentElement.appendChild(host);
    shadow = host.attachShadow ? host.attachShadow({ mode: 'open' }) : host.createShadowRoot();
    const style = document.createElement('style');
    style.textContent = CSS;
    shadow.appendChild(style);
    panel = document.createElement('div');
    panel.className = 'panel basic';
    shadow.appendChild(panel);
    setupEvents();
  }

  function togglePanel() {
    ensurePanel();
    if (state.minimized) { state.minimized = false; const p = shadow.getElementById('ogstats-pill'); if (p) p.remove(); }
    state.visible = !state.visible;
    if (state.visible) { refreshCookies().then(render); showPanel(); } else { hidePanel(); if (state.minimized) renderPill(); }
  }

  /* ================================ BOOT ================================= */

  function bootUI() {
    if (state.active && state.visible && !state.minimized) {
      ensurePanel();
      refreshCookies().then(render);
      showPanel();
    }
  }

  function activate() {
    state.active = true;
    // hooks (document-start: run as early as possible)
    try { patchFetch(); } catch (e) { /* ignore */ }
    try { patchXHR(); } catch (e) { /* ignore */ }
    try { patchWebSocket(); } catch (e) { /* ignore */ }
    // google maps tracker
    const mapsTimer = setInterval(() => {
      mapsPollTries++;
      if ((patchGoogleMaps() && mapsPatched) || mapsPollTries > 360) clearInterval(mapsTimer);
    }, 500);
    setInterval(pollPanos, CFG.refreshMs);
    setInterval(() => {
      if (panel && state.visible && !state.minimized &&
          (state.tab === 'location' || state.tab === 'google' || state.tab === 'overview')) {
        render();
      }
    }, 1500);
    // UI when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => { scanTokens(); bootUI(); });
    } else {
      scanTokens(); bootUI();
    }
    // hotkey
    document.addEventListener('keydown', ev => {
      if (ev.ctrlKey && ev.shiftKey && (ev.key === 'O' || ev.key === 'o')) {
        ev.preventDefault();
        togglePanel();
      }
    }, true);
    console.log('[OG Stats] Inspector active on ' + location.hostname);
  }

  // menu commands (available even when the host is not auto-activated)
  try {
    if (typeof GM_registerMenuCommand === 'function') {
      GM_registerMenuCommand('OG Stats: toggle panel (Ctrl+Shift+O)', () => {
        if (!state.active) activate();
        togglePanel();
      });
      GM_registerMenuCommand('OG Stats: enable on this host', () => {
        store('host.' + location.hostname, true);
        if (!state.active) activate(); else bootUI();
        alert('[OG Stats] Enabled on ' + location.hostname);
      });
      GM_registerMenuCommand('OG Stats: switch Basic / Advanced', () => {
        state.mode = state.mode === 'basic' ? 'advanced' : 'basic';
        store('mode', state.mode);
        if (!state.active) activate();
        if (!state.visible) { state.visible = true; }
        if (state.minimized) state.minimized = false;
        bootUI();
      });
      GM_registerMenuCommand('OG Stats: save current login as token profile', () => {
        if (!state.active) activate();
        const items = detectAuthItems();
        if (!items.length) { alert('[OG Stats] No tokens detected on this page — sign in first.'); return; }
        const label = prompt('[OG Stats] Label for this login:', 'account @ ' + location.hostname);
        if (label === null) return;
        saveTokenProfile(label, items);
        alert('[OG Stats] Saved ' + items.length + ' token(s) as "' + (label || 'Untitled token') + '" — log in anytime from the Tokens tab.');
      });
    }
  } catch (e) { /* ignore */ }

  if (isTargetSite()) {
    activate();
  } else {
    console.log('[OG Stats] Not active on ' + location.hostname + ' — use the userscript-manager menu command "OG Stats: enable on this host", or add the hostname to CFG.hosts.');
  }
})();
