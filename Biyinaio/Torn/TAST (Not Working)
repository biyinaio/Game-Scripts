      font: bold 10.5px Arial; color: #fff; background: linear-gradient(180deg,#1f9d55,#146b3a);
      transition: transform .12s; flex-shrink: 0; }
    #t3 .deal .go:hover { transform: scale(1.07); }
    #t3 .deal .go.sell { background: linear-gradient(180deg,#96202e,#7a1020); }
