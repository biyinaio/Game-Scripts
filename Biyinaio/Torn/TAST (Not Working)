    #t3 .log .w { color: #ffb0a0; } #t3 .log .t { color: #6fe38a; } #t3 .log .s { color: #54a0ff; }
    #t3-orb { position: fixed; z-index: 99998; width: 48px; height: 48px; border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #ff6b6b, #7a1020 75%); border: 2px solid #ff4757;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      font: bold 12px Arial; color: #fff; user-select: none; animation: t3-pulse 2.4s infinite;
      box-shadow: 0 4px 18px rgba(122,16,32,.55); transition: transform .2s; }
    #t3-orb:hover { transform: scale(1.12); }
  `;

  function buildUI() {
    if (document.getElementById('t3')) return;
    const css = document.createElement('style'); css.textContent = STYLE;
    document.head.appendChild(css);

    const root = document.createElement('div'); root.id = 't3';
    root.innerHTML = `
      <div class="head" id="t3-head">
        <span><span class="dot" id="t3-dot"></span><b>TAST</b> <span id="t3-sub" style="color:#bbb;font-size:10px">off</span></span>
        <button class="hbtn" id="t3-min">—</button>
      </div>
      <div class="ctl">
        <button class="bigbtn on" id="t3-on">ON</button>
        <button class="bigbtn off" id="t3-off">OFF</button>
      </div>
      <div class="mode">
        <button id="t3-assisted">ASSISTED</button>
        <button id="t3-full">FULL AUTO</button>
      </div>
      <label class="anon"><input type="checkbox" id="t3-anon"> sell anonymously (+10% fee)</label>
      <div class="stats">
        <div><div class="k">cash</div><div id="t3-cash">-</div></div>
        <div><div class="k">deals</div><div id="t3-deals" style="color:#6fe38a">0</div></div>
        <div><div class="k">holdings</div><div id="t3-hold">0</div></div>
        <div><div class="k">P&amp;L</div><div id="t3-pnl" style="color:#6fe38a">$0</div></div>
      </div>
      <div class="pace" id="t3-pace"></div>
      <div class="body" id="t3-body"></div>
      <div class="log" id="t3-log"></div>`;
    document.body.appendChild(root);

    const orb = document.createElement('div'); orb.id = 't3-orb'; orb.textContent = 'T';
    document.body.appendChild(orb);

    root.querySelector('#t3-on').onclick = () => { CFG.on = true; saveConfig(); log('Switched ON - reading pages', 'scan'); render(); };
    root.querySelector('#t3-off').onclick = () => { CFG.on = false; saveConfig(); log('Switched OFF', 'scan'); render(); };
    root.querySelector('#t3-assisted').onclick = () => { CFG.mode = 'assisted'; saveConfig(); log('Mode: ASSISTED (you click)', 'scan'); render(); };
    root.querySelector('#t3-full').onclick = () => { CFG.mode = 'full-auto'; saveConfig();
      log('Mode: FULL AUTO - browsing + trading by itself. Breaks Torn scripting rules; your call.', 'warn'); render(); };
    root.querySelector('#t3-anon').onchange = (e) => { CFG.anon = e.target.checked; saveConfig();
      log(e.target.checked ? 'Anonymous selling ON (+10% fee in math)' : 'Anonymous selling OFF', 'scan'); render(); };
    root.querySelector('#t3-min').onclick = () => { root.classList.add('min'); ui.pos.min = true; store.set(KEYS.ui, ui.pos); };
    orb.onclick = () => { root.classList.remove('min'); ui.pos.min = false; store.set(KEYS.ui, ui.pos); render(); };

    const head = root.querySelector('#t3-head');
    if (ui.pos.px !== null) { root.style.left = ui.pos.px + 'px'; root.style.top = ui.pos.py + 'px'; root.style.right = 'auto'; root.style.bottom = 'auto'; }
    head.addEventListener('pointerdown', (e) => {
      if (e.target.tagName === 'BUTTON') return;
      const r = root.getBoundingClientRect();
      const ox = e.clientX - r.left, oy = e.clientY - r.top;
      root.style.right = 'auto'; root.style.bottom = 'auto';
      const mv = (ev) => {
        root.style.left = Math.min(Math.max(0, ev.clientX - ox), innerWidth - 60) + 'px';
        root.style.top = Math.min(Math.max(0, ev.clientY - oy), innerHeight - 30) + 'px';
      };
      const up = () => {
        document.removeEventListener('pointermove', mv); document.removeEventListener('pointerup', up);
        ui.pos.px = parseInt(root.style.left, 10); ui.pos.py = parseInt(root.style.top, 10);
        store.set(KEYS.ui, ui.pos);
      };
      document.addEventListener('pointermove', mv); document.addEventListener('pointerup', up);
    });

    if (ui.pos.min) root.classList.add('min');
    render();
  }

  let lastAnalysis = null;

  function render() {
    const root = document.getElementById('t3');
    if (!root) return;
    const full = CFG.mode === 'full-auto';
    const dot = root.querySelector('#t3-dot');
    dot.classList.toggle('off', !CFG.on);
    dot.classList.toggle('busy', CFG.on && full);
    root.querySelector('#t3-sub').textContent = CFG.on ? (full ? '· full auto' : '· assisted') : 'off';
    root.querySelector('#t3-on').disabled = CFG.on;
    root.querySelector('#t3-off').disabled = !CFG.on;
    root.querySelector('#t3-assisted').classList.toggle('sel', !full);
    root.querySelector('#t3-full').classList.toggle('sel', full);
    root.querySelector('#t3-anon').checked = !!CFG.anon;

    const pnl = store.get(KEYS.pnl, { total: 0, trades: 0 });
    const pos = getPositions();
    const hold = Object.values(pos).reduce((a, p) => a + p.qty, 0);

    lastAnalysis = CFG.on ? analyze(full) : null;
    const a = lastAnalysis;

    root.querySelector('#t3-cash').textContent = a ? fmt$(a.cash) : '-';
    root.querySelector('#t3-deals').textContent = a ? a.deals.length + a.sells.length : 0;
    root.querySelector('#t3-hold').textContent = hold;
    const pnlEl = root.querySelector('#t3-pnl');
    pnlEl.textContent = (pnl.total >= 0 ? '+' : '') + fmt$(Math.abs(pnl.total));
    pnlEl.style.color = pnl.total >= 0 ? '#6fe38a' : '#ff6a6a';

    // pace line (full auto)
    const pace = root.querySelector('#t3-pace');
    if (CFG.on && full) {
      const since = bot.lastTrade ? age(bot.lastTrade) : '-';
      pace.textContent = `⚡ ${bot.trades} trades this session · last ${since} ago · browsing pages autonomously`;
    } else if (CFG.on) {
      pace.textContent = '';
    } else pace.textContent = '';

    // deals list
    const body = root.querySelector('#t3-body');
    if (!CFG.on || !a || (!a.deals.length && !a.sells.length)) {
      body.innerHTML = CFG.on
        ? '<div style="color:#77778a;padding:4px 2px">Reading pages… deals appear when an item dips below its average price.</div>'
        : '<div style="color:#77778a;padding:4px 2px">Off.</div>';
    } else {
      body.innerHTML =
        a.deals.map((d, i) => `
          <div class="deal">
            <div class="nm">${esc(d.name)}<small>buy ${d.source} @ ${fmt$(d.buyPrice)} · avg ${fmt$(d.avg)} · -${d.dipPct.toFixed(1)}% · ~${fmt$(d.profit)}/ea</small></div>
            ${full ? '' : `<button class="go" data-buy="${i}">BUY</button>`}
          </div>`).join('') +
        a.sells.map((s, i) => `
          <div class="deal sellrow">
            <div class="nm">${esc(s.name)}<small>hold ${s.qty} @ ${fmt$(s.avgCost)} · now ${fmt$(s.price)} · +${s.gainPct.toFixed(1)}%</small></div>
            ${full ? '' : `<button class="go sell" data-sell="${i}">SELL</button>`}
          </div>`).join('');
      body.querySelectorAll('[data-buy]').forEach((b) =>
        b.onclick = () => actBuy(a.deals[Number(b.dataset.buy)]));
      body.querySelectorAll('[data-sell]').forEach((b) =>
        b.onclick = () => actSell(a.sells[Number(b.dataset.sell)]));
    }

    renderLog();
  }

  function renderLog() {
    const el = document.getElementById('t3-log');
    if (!el) return;
    el.innerHTML = LOG.slice(0, 12).map((l) =>
      `<div class="${l.kind === 'warn' ? 'w' : l.kind === 'trade' ? 't' : l.kind === 'scan' ? 's' : ''}">` +
      `[${new Date(l.t).toLocaleTimeString()}] ${esc(l.msg)}</div>`).join('') ||
      '<div style="color:#555">no activity yet</div>';
  }

  /* ------------------------------------------------------------------
   * Init + loops
   * ------------------------------------------------------------------ */
  function start() {
    buildUI();
    log('TAST v3.1 loaded - ON/OFF + mode selector.', 'scan');

    // instant harvest whenever the page content changes
    let harvestTimer = null;
    try {
      const obs = new MutationObserver(() => {
        if (!CFG.on) return;
        clearTimeout(harvestTimer);
        harvestTimer = setTimeout(harvestPage, 200);
      });
      obs.observe(document.body, { childList: true, subtree: true });
    } catch {}

    // the bot brain: fast tick
    setInterval(() => { botTick().then(() => render()); }, BOT_TICK_MS);

    // assisted-mode refresh + pace line update
    setInterval(() => {
      if (CFG.on && CFG.mode !== 'full-auto') render();
      else if (CFG.on) render(); // keep pace line fresh
    }, 1500);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
